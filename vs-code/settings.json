{
    "terminal.integrated.fontFamily": "Cascadia Code NF",
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "terminal.integrated.defaultProfile.osx": "nushell",
    "terminal.integrated.profiles.osx": {
        "nushell": {
            "path": "/opt/homebrew/bin/nu",
        },
    },
    "terminal.integrated.tabs.defaultIcon": "github-action",
    "terminal.integrated.fontSize": 13,
    "terminal.integrated.suggest.selectionMode": "always",
    "diffEditor.wordWrap": "on",
    "editor.defaultFormatter": "ms-dotnettools.csdevkit",
    "editor.linkedEditing": true,
    "editor.fontFamily": "Cascadia Code",
    "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
    "editor.guides.bracketPairs": "active",
    "editor.wordWrap": "on",
    "editor.wordWrapColumn": 120,
    "editor.rulers": [100],
    "editor.formatOnSave": true,
    "editor.suggest.shareSuggestSelections": true,
    "editor.suggest.showStatusBar": true,
    "editor.suggest.snippetsPreventQuickSuggestions": true,
    "editor.minimap.renderCharacters": false,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "extensions.experimental.affinity": {
        "vscodevim.vim": 1,
    },
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.ignoreRebaseWarning": true,
    "git.enableSmartCommit": true,
    "[go]": {
        "editor.defaultFormatter": "golang.go",
    },
    "[json]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
    },
    "[scss]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "tailwindCSS.suggestions": true,
        "editor.tabCompletion": "on",
    },
    "[css]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "tailwindCSS.suggestions": true,
        "editor.tabCompletion": "on",
    },
    "[html]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "tailwindCSS.suggestions": true,
        "editor.tabCompletion": "on",
    },
    "[csharp]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp",
    },
    "[proto3]": {
        "editor.defaultFormatter": "zxh404.vscode-proto3",
        "editor.tabCompletion": "on",
    },
    "prettier.singleAttributePerLine": true,
    "prettier.tabWidth": 4,
    "prettier.vueIndentScriptAndStyle": true,
    "powermode.explosions.frequency": 1,
    "powermode.enabled": true,
    "powermode.shake.intensity": 0,
    "powermode.presets": "flames",
    "powermode.combo.location": "off",
    "powermode.combo.counterEnabled": "hide",
    //Vim
    "vim.autoindent": false,
    "vim.camelCaseMotion.enable": true,
    "vim.leader": "<space>",
    "vim.smartRelativeLine": true,
    "vim.hlsearch": true,
    "vim.easymotion": true,
    "vim.incsearch": true,
    "vim.useSystemClipboard": true,
    "vim.useCtrlKeys": true,
    "vim.normalModeKeyBindings": [
        // buffers agora ficam no ctrl+h/ctrl+l (keybindings.json)
        // ui (janelas/splits agora ficam no ctrl+w do keybindings.json)
        {
            "before": ["<leader>", "u", "z"],
            "commands": [
                { "command": "workbench.action.toggleCenteredLayout" },
            ],
        },
        // code
        {
            "before": ["<leader>", "c", "a"],
            "commands": ["editor.action.quickFix"],
        },
        {
            "before": ["<leader>", "c", "r"],
            "commands": ["editor.action.rename"],
        },
        // tests
        {
            "before": ["<leader>", "t", "t"],
            "commands": ["testing.runAtCursor"],
        },
        {
            "before": ["<leader>", "t", "d"],
            "commands": ["testing.debugAtCursor"],
        },
        {
            "before": ["<leader>", "t", "f"],
            "commands": ["testing.runCurrentFile"],
        },
        {
            "before": ["<leader>", "t", "a"],
            "commands": ["testing.runAll"],
        },
        {
            "before": ["<leader>", "t", "l"],
            "commands": ["testing.reRunLastRun"],
        },
        // bookmarks
        {
            "before": ["<leader>", "m"],
            "commands": ["bookmarks.toggle"],
        },
        {
            "before": ["<leader>", "<S-m>"],
            "after": [
                "o",
                "/",
                "/",
                "T",
                "O",
                "D",
                "O",
                ":",
                " ",
                "<esc>",
                "space",
                "m",
                "a",
            ],
        },
        {
            "before": ["<leader>", "b"],
            "commands": ["bookmarks.list"],
        },
        {
            "before": ["<leader>", "r"],
            "after": [":", "%", "s", "/"],
        },
        {
            "before": ["<leader>", "<leader>", "d"], //run docker compose
            "commands": ["editor.debug.action.runToCursor"],
        },
        {
            "before": ["<leader>", "<leader>", "r"], //run file http
            "commands": ["rest-client.request"],
        },
        {
            "before": ["<C-d>"],
            "after": ["<C-d>", "z", "z"],
        },
        {
            "before": ["<C-u>"],
            "after": ["<C-u>", "z", "z"],
        },
        {
            "before": ["n"],
            "after": ["n", "z", "z", "z", "v"],
        },
        {
            "before": ["N"],
            "after": ["N", "z", "z", "z", "v"],
        },
    ],
    "vim.visualModeKeyBindings": [
        {
            "before": ["J"],
            "after": [
                ":",
                "m",
                " ",
                "'",
                ">",
                "+",
                "1",
                "<CR>",
                "g",
                "v",
                "=",
                "g",
                "v",
            ],
        },
        {
            "before": ["K"],
            "after": [
                ":",
                "m",
                " ",
                "'",
                "<",
                "-",
                "2",
                "<CR>",
                "g",
                "v",
                "=",
                "g",
                "v",
            ],
        },
    ],
    "csharp.inlayHints.enableInlayHintsForImplicitVariableTypes": true,
    "csharp.inlayHints.enableInlayHintsForTypes": true,
    "dotnet.automaticallySyncWithActiveItem": true,
    "dotnet.formatting.organizeImportsOnFormat": true,
    "dotnet.inlayHints.enableInlayHintsForIndexerParameters": true,
    "dotnet.inlayHints.enableInlayHintsForLiteralParameters": true,
