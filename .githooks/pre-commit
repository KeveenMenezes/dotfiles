#!/bin/bash
# Repositório público: barra o commit se o diff staged tiver segredo.
# Ativado pelo install.sh (git config core.hooksPath .githooks). Pular só se tiver certeza: git commit --no-verify
set -euo pipefail

fail=0

if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --pre-commit --staged --redact --no-banner || fail=1
else
    echo "aviso: gitleaks não instalado (brew install gitleaks); fazendo só a checagem básica" >&2
fi

# URL com usuário:senha@ escrita direto (o padrão aqui é ${env:NOME} + Keychain)
if git diff --cached -U0 --no-color | grep -E '^\+' | grep -v -E '^\+\+\+' |
    grep -E '[a-z][a-z0-9+.-]*://[^/@:[:space:]]+:[^@[:space:]]+@' | grep -v -E ':\$\{env:[A-Za-z0-9_]+\}@'; then
    echo "pre-commit: URL com senha embutida no diff acima; use \${env:NOME} e guarde o valor no Keychain" >&2
    fail=1
fi

exit "$fail"
